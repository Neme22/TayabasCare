# Deny access to secrets and sensitive files
<FilesMatch "^\.">
    Require all denied
</FilesMatch>
<FilesMatch "\.(env|example|log|bak|old|swp|sql)$">
    Require all denied
</FilesMatch>

# Deny direct access to .env in php/
<Files ".env">
    Require all denied
</Files>

# Clean URLs: /admin, /inspector (no .html in address bar)
RewriteEngine On

# Redirect .html URLs to clean versions (capture path from THE_REQUEST — works at root and in subdirs)
RewriteCond %{THE_REQUEST} \s([^\s?]+)\.html(?:\?[^\s]*)?\s
RewriteRule ^ %1 [R=301,L,QSA]

# Map clean URLs to the real files
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^admin/?$ admin.html [L,QSA]
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^inspector/?$ inspector.html [L,QSA]
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^index/?$ index.html [L,QSA]